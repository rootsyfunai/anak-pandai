# Copy to .env.local for local development. These are SERVER variables:
# they are read by server/index.mjs only and must never be prefixed VITE_.
DATABASE_URL=

# Cloudflare R2 (S3-compatible) — payment receipts. Optional locally.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Transactional e-mail for password resets. Optional locally: the reset link
# is printed to the console when this is unset outside production.
RESEND_API_KEY=
MAIL_FROM=
APP_ORIGIN=

# Cloudflare image CDN base URL, no trailing slash.
# Images must never be served from Railway — see .github/copilot-instructions.md.
# When unset, <CdnImage> renders its CSS fallback instead of a broken image.
VITE_IMAGE_CDN=
