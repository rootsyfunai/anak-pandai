# Railway / static hosting config.
#
# The app is a static SPA. Railway should serve pre-built files, never run a
# long-lived Node server — a server process holds memory open and bills for
# idle time, while static file serving costs almost nothing.

# Long-lived immutable caching for hashed assets. This is the single biggest
# lever on egress cost: a cached asset is free to re-serve. Vite hashes
# filenames, so a changed file always gets a new URL and can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML entry point must never be cached, or users get a stale shell that
# references deleted asset hashes after a deploy.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Small UI chrome only. Content images live on Cloudflare, not here.
/favicon.svg
  Cache-Control: public, max-age=604800

/qr-payment.svg
  Cache-Control: public, max-age=86400

# SPA fallback: every unknown path serves the app shell so client-side
# routing works on deep links and refreshes.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
